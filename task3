#include <unistd.h>
#include <stdlib.h>
#include <stdio.h>
#include <string.h>
#include <sys/wait.h>
#include <errno.h>

#define BUF_SIZE 8192

ssize_t write_full(int fd, const void *buf, size_t count)
{
    size_t total = 0;
    const char *p = buf;

    while(total < count){
        ssize_t n = write(fd, p + total, count - total);
        if(n < 0){
            if(errno == EINTR)
                continue;
            return -1;
        }
        total += n;
    }

    return total;
}

int main(int argc, char *argv[])
{
    if(argc < 2){
        fprintf(stderr, "Usage: %s arg1 arg2 ...\n", argv[0]);
        return 1;
    }

    int pipefd[2];
    if(pipe(pipefd) == -1){
        perror("pipe");
        return 1;
    }

    pid_t pid = fork();
    if(pid < 0){
        perror("fork");
        close(pipefd[0]);
        close(pipefd[1]);
        return 1;
    }

    if(pid == 0){
        close(pipefd[1]);

        char buffer[BUF_SIZE];

        while(1){
            ssize_t n = read(pipefd[0], buffer, sizeof(buffer));
            if(n < 0){
                if(errno == EINTR)
                    continue;
                perror("read");
                close(pipefd[0]);
                exit(1);
            }

            if(n == 0)
                break;

            if(write_full(STDOUT_FILENO, buffer, n) < 0){
                perror("write");
                close(pipefd[0]);
                exit(1);
            }
        }

        close(pipefd[0]);
        exit(0);
    }
    else{
        close(pipefd[0]);

        char buffer[BUF_SIZE];
        size_t offset = 0;

        for(int i = 1; i < argc; i++){
            size_t len = strlen(argv[i]);

            if(offset + len + 1 > sizeof(buffer)){
                if(write_full(pipefd[1], buffer, offset) < 0){
                    perror("write");
                    close(pipefd[1]);
                    wait(NULL);
                    return 1;
                }
                offset = 0;
            }

            memcpy(buffer + offset, argv[i], len);
            offset += len;
            buffer[offset++] = '\n';
        }

        if(offset > 0){
            if(write_full(pipefd[1], buffer, offset) < 0){
                perror("write");
                close(pipefd[1]);
                wait(NULL);
                return 1;
            }
        }

        close(pipefd[1]);

        wait(NULL);
        return 0;
    }
}
